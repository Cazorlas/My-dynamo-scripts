    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\n\r\nimport math\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.UI import *\r\n\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuidoc=DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\n\r\nelements_points = IN[0]\r\nelements_length = IN[1]\r\nelements_shape = IN[2]\r\n\r\ndef is_close(a,b):\r\n\treturn abs(a - b) < 0.1\r\n\r\nelements_vectors_length = []\r\n\r\ndef round_to_nearest_10(number):\r\n    return round(number / 10) * 10\r\n\r\nfor i in range(0,len(elements_length)):\r\n    if elements_shape[i] != \"ROUND\":\r\n        pointA = elements_points[i][0]\r\n        pointB = elements_points[i][1]\r\n        pointC = elements_points[i][2]\r\n        pointD = elements_points[i][3]\r\n        pointE = elements_points[i][4]\r\n        pointF = elements_points[i][5]\r\n\r\n        length1 = round_to_nearest_10(math.sqrt((pointB.X - pointA.X)**2 + (pointB.Y - pointA.Y)**2 + (pointB.Z - pointA.Z)**2))\r\n        length2 = round_to_nearest_10(math.sqrt((pointE.X - pointC.X)**2 + (pointE.Y - pointC.Y)**2 + (pointE.Z - pointC.Z)**2))\r\n        length3 = round_to_nearest_10(math.sqrt((pointF.X - pointD.X)**2 + (pointF.Y - pointD.Y)**2 + (pointF.Z - pointD.Z)**2))\r\n        \r\n        duct_vectors = []\r\n        if is_close(length1, elements_length[i]):\r\n            if length2>length3:\r\n                size = str(int(length2)) + \"x\" + str(int(length3))\r\n            else:\r\n                size = str(int(length3)) + \"x\" + str(int(length2))\r\n        elif is_close(length2, elements_length[i]):\r\n            if length1>length3:\r\n                size = str(int(length1)) + \"x\" + str(int(length3))\r\n            else:\r\n                size = str(int(length3)) + \"x\" + str(int(length1))\r\n        elif is_close(length3, elements_length[i]):\r\n            if length1>length2:\r\n                size = str(int(length1)) + \"x\" + str(int(length2))\r\n            else:\r\n                size = str(int(length2)) + \"x\" + str(int(length1))\r\n        \r\n        elements_vectors_length.append(size)\r\n\r\n    else:\r\n        pointA = elements_points[i][2]\r\n        pointB = elements_points[i][3]\r\n\r\n        length1 = math.sqrt((pointB.X - pointA.X)**2 + (pointB.Y - pointA.Y)**2 + (pointB.Z - pointA.Z)**2)\r\n\r\n        size = \"Ø\" + str(int(round(length1)))\r\n\r\n        elements_vectors_length.append(size)\r\n\r\nOUT = elements_vectors_length",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "9ff35c7a7fc24cacb5c307e07f05bbca",
