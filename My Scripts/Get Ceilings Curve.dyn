    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\nlstCheck = IN[0]  # Danh sách đầu vào cần kiểm tra\r\n\r\n# Kiểm tra nếu danh sách không rỗng\r\nresult = []\r\nif lstCheck and isinstance(lstCheck, list):\r\n    max_value = max(lstCheck)  # Tìm giá trị lớn nhất trong danh sách\r\n    found_max = False  # Cờ đánh dấu khi đã gặp giá trị lớn nhất đầu tiên\r\n    \r\n    for x in lstCheck:\r\n        if not found_max and x == max_value:\r\n            result.append(True)  # Đánh dấu True cho giá trị lớn nhất đầu tiên\r\n            found_max = True  # Cập nhật cờ\r\n        else:\r\n            result.append(False)  # Các giá trị khác là False\r\nelse:\r\n    result = []  # Trả về danh sách rỗng nếu đầu vào không hợp lệ\r\n\r\n# Assign your output to the OUT variable.\r\nOUT = result\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "557cc83e978f41369a45dc409e03c6e1",
      "Inputs": [
        {
          "Id": "3851aecd31c943388973fcdc5ed670a7",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "44587987eacd4800929715bbc70e8fe1",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
