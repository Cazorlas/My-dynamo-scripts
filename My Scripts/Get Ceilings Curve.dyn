    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Đầu vào từ Dynamo\r\ninput_list = IN[0]  # Danh sách cần kiểm tra\r\n\r\n# Hàm kiểm tra tất cả các phần tử trong danh sách có bằng nhau hay không\r\ndef all_elements_equal(lst):\r\n    if len(lst) == 0:\r\n        return False  # Danh sách rỗng trả về False\r\n    return all(x == lst[0] for x in lst)\r\n\r\n# Thực thi hàm\r\nif isinstance(input_list, list):\r\n    result = all_elements_equal(input_list)\r\nelse:\r\n    result = False  # Nếu không phải danh sách, trả về False\r\n\r\n# Đầu ra tới Dynamo\r\nOUT = result\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "0eb26d4a118e488796f57052910730ff",
      "Inputs": [
