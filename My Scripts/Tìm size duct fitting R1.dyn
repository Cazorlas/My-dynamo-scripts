    {
      "ConcreteType": "Dynamo.ComboNodes.DSModelElementsByCategorySelection, DSRevitNodesUI",
      "SelectedIndex": 183,
      "SelectedString": "OST_DuctFitting",
      "NodeType": "ExtensionNode",
      "InstanceId": [
        "55346a5a-1094-4b14-bf6e-bf1812ec2de0-0004caea",
        "55346a5a-1094-4b14-bf6e-bf1812ec2de0-0004cb5f",
