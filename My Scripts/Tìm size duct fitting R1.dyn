    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "NodeType": "FunctionNode",
      "FunctionSignature": "Revit.Elements.Element.Faces",
      "Id": "3e4dd1bc31584204b17a1f35da135a9c",
      "Inputs": [
        {
          "Id": "3ddd6b14ec814f04990c0ae788f52d07",
          "Name": "element",
          "Description": "Revit.Elements.Element",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "a4a7bd5bb4e1424eaa30e6139aa3e540",
          "Name": "Surface[]",
          "Description": "Surface[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "The Faces in this Element\n\nElement.Faces: Surface[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nimport math\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.UI import *\r\n\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\n\r\n# Data của round duct\r\nround_sizes = [100, 125, 160, 200, 250, 315, 355, 400, 450, 500, 560, 630, 710, 800, 1000, 1120, 1250]\r\n\r\n# Tìm 3 diện tích mặt lớn nhất và index của nó\r\ndef find_three_largest_numbers(numbers):\r\n    if len(numbers) < 3:\r\n        raise ValueError(\"Danh sách phải có ít nhất 3 số\")\r\n\r\n    largest = second_largest = third_largest = float('-inf')\r\n    index1 = index2 = -1\r\n\r\n    for i, number_ in enumerate(numbers):\r\n        number = round_to_nearest_5000(number_)\r\n        if number > largest:\r\n            third_largest = second_largest\r\n            second_largest = largest\r\n            largest = number\r\n            index2 = index1\r\n            index1 = i\r\n        elif number > second_largest and number != largest:\r\n            third_largest = second_largest\r\n            second_largest = number\r\n            index2 = i\r\n        elif number > third_largest and number != largest and number != second_largest:\r\n            third_largest = number\r\n    return largest, second_largest, third_largest, index1, index2\r\n\r\n# Làm tròn thành size của ống tròn\r\ndef find_closest_size(size):\r\n    min_diff = float('inf')\r\n    closest_size = size\r\n    for round_size in round_sizes:\r\n        diff = abs(round_size - size)\r\n        if diff < min_diff:\r\n            min_diff = diff\r\n            closest_size = round_size\r\n    return closest_size\r\n\r\n# Làm tròn 1 số theo 50\r\ndef round_to_nearest_50(number):\r\n    return round(number / 50) * 50\r\n\r\n# Làm tròn 1 số theo 5000\r\ndef round_to_nearest_5000(number):\r\n    return round(number / 5000) * 5000\r\n\r\n# Function to check if a face contains any arc curves\r\ndef face_contains_specific_curve(curves, type_curve):\r\n    for curve in curves:\r\n        if curve.GetType().Name == type_curve:\r\n            return True\r\n    return False\r\n\r\n# Function to find the largest face that does not contain any arc curves \r\ndef find_largest_non_arc_face(areas, curves, type_curve):\r\n    largest_area = second_area = 0\r\n    \r\n    for i, area_ in enumerate(areas):\r\n        area = round_to_nearest_5000(area_)\r\n        if not face_contains_specific_curve(curves[i], type_curve):\r\n            if area > largest_area:\r\n                largest_area = area\r\n                index_largest = i\r\n            elif area > second_area and area != largest_area:\r\n                second_area = area\r\n                index_second = i\r\n            elif area == largest_area:\r\n                index_second = i\r\n    \r\n    return index_largest, index_second\r\n\r\nelements = IN[0]\r\nelements_surfaces = IN[1]\r\nelements_curses = IN[2]\r\n\r\n# Đầu vào\r\nsizes = []\r\nname_LDR = \"LDR:LDR\"\r\nname_LORU = \"LORU:LORU\"\r\nname_LBXR = \"LBXR:LBXR\"\r\nname_LBR = \"LBR:LBR\"\r\nname_LEPR = \"LEPR:LEPR\"\r\n\r\nfor i, element in enumerate(elements):\r\n    fitting_type = element.GetParameterValueByName(\"ObjectTypeOverride\")\r\n    faces = elements_surfaces[i]\r\n    if faces is not None:\r\n        areas = []\r\n        for face in faces:\r\n            area = face.Area\r\n            areas.append(area)\r\n            \r\n        if name_LDR in fitting_type:\r\n            largest_area, second_largest_area, third_largest_area, index1, index2 = find_three_largest_numbers(areas)\r\n            \r\n            Length1 = round_to_nearest_50(elements_curses[i][index1][0].Length)\r\n            Length2 = round_to_nearest_50(elements_curses[i][index1][1].Length)\r\n            Length3 = round_to_nearest_50(elements_curses[i][index2][0].Length)\r\n            Length4 = round_to_nearest_50(elements_curses[i][index2][1].Length)\r\n            \r\n            if Length1 > Length2:\r\n                Length1_ = Length1\r\n                Length2_ = Length2\r\n            else:\r\n                Length1_ = Length2\r\n                Length2_ = Length1\r\n\r\n            if Length3 > Length4:\r\n                Length3_ = Length3\r\n                Length4_ = Length4\r\n            else:\r\n                Length3_ = Length4\r\n                Length4_ = Length3\r\n\r\n            size = str(int(Length1_)) + \"x\" + str(int(Length2_)) + \"-\" + str(int(Length3_)) + \"x\" + str(int(Length4_))\r\n            sizes.append(size)\r\n        #LORU giải thuật là tìm 2 mặt có diện tích lớn nhất và nhì rồi lấy curve Line và Circle của mặt để lấy kích thước\r\n        elif name_LORU in fitting_type:\r\n            largest_area, second_largest_area, third_largest_area, index1, index2 = find_three_largest_numbers(areas)\r\n            \r\n            type_curse_largest = elements_curses[i][index1][0].GetType().Name\r\n            type_curse_second = elements_curses[i][index2][0].GetType().Name\r\n            if type_curse_largest == \"Line\" and type_curse_second == \"Circle\":\r\n                Length1 = round_to_nearest_50(elements_curses[i][index1][0].Length)\r\n                Length2 = round_to_nearest_50(elements_curses[i][index1][1].Length)\r\n                if Length1 > Length2:\r\n                    Length1_ = Length1\r\n                    Length2_ = Length2\r\n                else:\r\n                    Length1_ = Length2\r\n                    Length2_ = Length1\r\n                round_size = find_closest_size(elements_curses[i][index2][0].Radius*2)\r\n                size = str(int(Length1_)) + \"x\" + str(int(Length2_)) + \"-Ø\" + str(int(round_size))\r\n            elif type_curse_largest == \"Circle\" and type_curse_second == \"Line\":\r\n                Length1 = round_to_nearest_50(elements_curses[i][index2][0].Length)\r\n                Length2 = round_to_nearest_50(elements_curses[i][index2][1].Length)\r\n                round_size = find_closest_size(elements_curses[i][index1][0].Radius*2)\r\n                if Length1 > Length2:\r\n                    Length1_ = Length1\r\n                    Length2_ = Length2\r\n                else:\r\n                    Length1_ = Length2\r\n                    Length2_ = Length1\r\n                size = str(int(Length1_)) + \"x\" + str(int(Length2_)) + \"-Ø\" + str(int(round_size))\r\n            else:\r\n                size = \"Unknown\"\r\n            sizes.append(size)\r\n        \r\n        #LBXR giải thuật là tìm mặt ko chứa curve arc và có diện tích lớn nhất\r\n        elif name_LBXR in fitting_type:\r\n            index_largest, index_second = find_largest_non_arc_face(areas, elements_curses[i], \"Arc\")\r\n            Length1 = round_to_nearest_50(elements_curses[i][index_largest][0].Length)\r\n            Length2 = round_to_nearest_50(elements_curses[i][index_largest][1].Length)\r\n            size = str(int(Length1)) + \"x\" + str(int(Length2)) + \"-\" + str(int(Length1)) + \"x\" + str(int(Length2))\r\n            sizes.append(size)\r\n        #LBR giải thuật là tìm mặt ko chứa curve arc và có diện tích lớn nhì\r\n        elif name_LBR in fitting_type:\r\n            index_largest, index_second = find_largest_non_arc_face(areas, elements_curses[i], \"Arc\")\r\n            Length1 = round_to_nearest_50(elements_curses[i][index_second][0].Length)\r\n            Length2 = round_to_nearest_50(elements_curses[i][index_second][1].Length)\r\n            size = str(int(Length1)) + \"x\" + str(int(Length2)) + \"-\" + str(int(Length1)) + \"x\" + str(int(Length2))\r\n            sizes.append(size)\r\n        elif name_LEPR in fitting_type:\r\n            index_largest, index_second = find_largest_non_arc_face(areas, elements_curses[i], \"Arc\")\r\n            Length1 = round_to_nearest_50(elements_curses[i][index_largest][0].Length)\r\n            Length2 = round_to_nearest_50(elements_curses[i][index_largest][1].Length)\r\n            if Length1 > Length2:\r\n                Length1_ = Length1\r\n                Length2_ = Length2\r\n            else:\r\n                Length1_ = Length2\r\n                Length2_ = Length1\r\n            size = str(int(Length1_)) + \"x\" + str(int(Length2_)) + \"-\" + str(int(Length1_)) + \"x\" + str(int(Length2_))\r\n            sizes.append(size)\r\n\r\n        else:\r\n            sizes.append(\"Not found\")\r\n    else:\r\n        sizes.append(\"Not found\")\r\n\r\nOUT = sizes\r\n",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": true,
      "Id": "5c0e4077da844f07adb8b690f7c0e8e7",
      "Inputs": [
        {
          "Id": "02c49e2516df42c181150acb4bf9ad53",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3f5d3f39f84f447785cec620ed559c34",
          "Name": "IN[1]",
          "Description": "Input #1",
