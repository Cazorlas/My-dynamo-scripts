    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nimport math\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.UI import *\r\n\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\n\r\n#tìm 3 diện tích mặt lớn nhất và index của nó\r\ndef find_largest_numbers(numbers):\r\n    if len(numbers) < 2:\r\n        raise ValueError(\"Danh sách phải có ít nhất 2 số\")\r\n\r\n    largest = second_largest = float('-inf')\r\n    index1 = index2 = -1\r\n\r\n    for i, number_ in enumerate(numbers):\r\n    \tnumber = round_to_nearest_number(number_)\r\n        if number > largest:\r\n            second_largest = largest\r\n            largest = number\r\n            index2 = index1\r\n            index1 = i\r\n        elif number > second_largest and number != largest:\r\n            second_largest = number\r\n            index2 = i\r\n    return largest, second_largest, index1, index2\r\n\r\n#làm tròn thành size của ống tròn\r\ndef find_closest_size(size):\r\n    min_diff = float('inf')  # Khởi tạo giá trị min_diff lớn vô cực\r\n    closest_size = size  # Khởi tạo kích thước gần nhất là giá trị tính toán ban đầu\r\n    for round_size in round_sizes:\r\n        diff = abs(round_size - size)\r\n        if diff < min_diff:\r\n            min_diff = diff\r\n            closest_size = round_size\r\n    return closest_size\r\n\r\ndef round_to_nearest_number(number):\r\n    if number < 50000:\r\n        return round(number / 1000) * 1000\r\n    elif 50000 <= number < 100000:\r\n        return round(number / 2000) * 2000\r\n    elif 100000 <= number < 250000:\r\n        return round(number / 5000) * 5000\r\n    elif 250000 <= number < 510000:\r\n        return round(number / 10000) * 10000\r\n    elif 510000 <= number < 1000000:\r\n        return round(number / 20000) * 20000\r\n    else:\r\n        return round(number / 30000) * 30000\r\n\r\ndef round_to_nearest_2000(number):\r\n    return round(number / 2000) * 2000\r\n\r\n#SO sanh 2 so tuong duong trong khoang 1%\r\ndef are_numbers_equal_within_1_percent(num1, num2):\r\n    # Tính giá trị trung bình của hai số\r\n    avg = (num1 + num2) / 2.0\r\n    \r\n    # Kiểm tra sự chênh lệch có nằm trong khoảng 1% hay không\r\n    return abs(num1 - num2) <= 0.01 * avg\r\n\r\ndef is_round_bending(fitting_type):\r\n    for round_bending_name in round_bending_names:\r\n        if round_bending_name in fitting_type:\r\n            return True\r\n    return False\r\n\r\ndef is_round_tee(fitting_type):\r\n    for round_tee_name in round_tee_names:\r\n        if round_tee_name in fitting_type:\r\n            return True\r\n    return False\r\n\r\ndef is_round_transition(fitting_type):\r\n    for round_transition_name in round_transition_names:\r\n        if round_transition_name in fitting_type:\r\n            return True\r\n    return False\r\n\r\nelements = IN[0]\r\nelements_Surfaces = IN[1]\r\n\r\n#out result\r\nsizes = []\r\n\r\n#data cua round duct\r\nround_sizes = [100, 125, 160, 200, 250, 315, 355, 400, 450, 500, 560, 630, 710, 800, 1000, 1120, 1250]\r\nround_bending_names = [\"BU:BU\",\"BKU:BKU\",\"BFU:BFU\",\"BKFU:BKFU\"]\r\nround_tee_names = [\"TCPU:TCPU\",\"TCU:TCU\"]\r\nround_transition_names = [\"RCLU:RCLU\",\"RCU:RCU\"]\r\n     \r\nfor i,element in enumerate(elements):\r\n    fitting_type = element.GetParameterValueByName(\"ObjectTypeOverride\")\r\n    faces = elements_Surfaces[i]\r\n    if faces is not None:#Kiem tra doi tuong co face khong\r\n        areas = []\r\n        for face in faces:\r\n            area = face.Area\r\n            areas.append(area)\r\n\r\n        if is_round_bending(fitting_type):\r\n            largest_area, second_largest_area, index1, index2 = find_largest_numbers(areas)\r\n            \r\n            size_largest = math.sqrt(largest_area * 4 / 3.14) \r\n            closest_size_largest = find_closest_size(size_largest)\r\n\r\n            sizes.append(\"Ø\" + str(int(closest_size_largest)))\r\n\r\n        elif is_round_transition(fitting_type):   \r\n            largest_area, second_largest_area, index1, index2 = find_largest_numbers(areas)\r\n            \r\n            size_largest = math.sqrt(largest_area * 4 / 3.14) \r\n            size_second_largest = math.sqrt(second_largest_area * 4 / 3.14) \r\n            closest_size_largest = find_closest_size(size_largest)\r\n            closest_size_second_largest = find_closest_size(size_second_largest)\r\n\r\n            sizes.append(\"Ø\" + str(int(closest_size_largest)) + \"-Ø\" + str(int(closest_size_second_largest)))\r\n\r\n        elif is_round_tee(fitting_type):   \r\n            largest_area, second_largest_area, index1, index2 = find_largest_numbers(areas)\r\n            \r\n            size_largest = math.sqrt(largest_area * 4 / 3.14) \r\n            closest_size_largest = find_closest_size(size_largest)\r\n\r\n            sizes.append(\"Ø\" + str(int(closest_size_largest)) + \"-Ø\" + str(int(closest_size_largest)) + \"-Ø\" + str(int(closest_size_largest)))\r\n           \r\n        elif \"ILRU:ILRU\" in fitting_type:\r\n            largest_area, second_largest_area, index1, index2 = find_largest_numbers(areas)\r\n\r\n            size_largest = math.sqrt(largest_area * 4 / 3.14) \r\n            closest_size_largest = find_closest_size(size_largest)\r\n\r\n            sizes.append(\"Ø\" + str(int(closest_size_largest)))\r\n\r\n        else:\r\n            sizes.append(\"Not found\")\r\n    else:\r\n        sizes.append(\"Not found\")\r\nOUT = sizes\r\n",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": true,
