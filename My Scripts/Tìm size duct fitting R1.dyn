    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nimport math\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.UI import *\r\n\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\n\r\n\r\ndef is_round_bending(fitting_type):\r\n    for round_bending_name in round_bending_names:\r\n        if round_bending_name in fitting_type:\r\n            return True\r\n    return False\r\n\r\ndef is_round_tee(fitting_type):\r\n    for round_tee_name in round_tee_names:\r\n        if round_tee_name in fitting_type:\r\n            return True\r\n    return False\r\n\r\ndef is_round_transition(fitting_type):\r\n    for round_transition_name in round_transition_names:\r\n        if round_transition_name in fitting_type:\r\n            return True\r\n    return False\r\n\r\nelements = IN[0]\r\nround_bending_names = [\"BU:BU\",\"BKU:BKU\",\"BFU:BFU\",\"BKFU:BKFU\"]\r\nround_tee_names = [\"TCPU:TCPU\",\"TCU:TCU\"]\r\nround_transition_names = [\"RCLU:RCLU\",\"RCU:RCU\"]\r\n\r\n\r\nelement_s = []\r\n\r\nfor i,element in enumerate(elements):\r\n    fitting_type = element.GetParameterValueByName(\"ObjectTypeOverride\")\r\n    if is_round_bending(fitting_type) or is_round_tee(fitting_type) or is_round_transition(fitting_type) or \"ILRU:ILRU\" in fitting_type:\r\n    \telement_s.append(element)\r\nOUT = element_s\r\n",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": true,
      "Id": "fd306896d20545b5a716204be0b4257b",
