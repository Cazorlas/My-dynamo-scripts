    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "//Listed Angles with Paired Corrections\nString.Join(\"\",List.Flatten(\n[\n[\"From (\"+List.Count(List.UniqueItems(angleO))+\") Different Angles: \"],\n[List.UniqueItems(String.Replace(\"(\"+angleO+\",\"+angleC+\")\",\".000000\",\"\"))],\n[\"(original,corrected)\"]\n]\n, -1));\n\"Largest Correction: \"+\nList.MaximumItem(List.Flatten(angleO-angleC,-1))+\n\" Degrees\";",
      "Id": "8a7713d207274a2ca08c7bb47431fb82",
      "Inputs": [
        {
