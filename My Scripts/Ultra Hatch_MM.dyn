      "Replication": "Auto",
      "Description": "Translates any given geometry by the given displacements in the x, y, and z directions defined in WCS respectively.\n\nGeometry.Translate (xTranslation: double = 0, yTranslation: double = 0, zTranslation: double = 0): Geometry"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "//Box Builder\n//  The Bounds of the Hatch do not need to be a Square.\n//  Now more patterns are possible.\n\nallPoints =\nList.Flatten([\nAutodesk.Curve.StartPoint(curve),\nAutodesk.Curve.EndPoint(curve)\n],-1);\n\npointX = Point.X(allPoints);\npointY = Point.Y(allPoints);\nminX = List.MinimumItem(pointX);\nminY = List.MinimumItem(pointY);\nmaxX = List.MaximumItem(pointX);\nmaxY = List.MaximumItem(pointY);\n\n//Pattern Origin\nPoint.ByCoordinates(minX,minY);\n\n//Pattern Width/Scale\npatternWidth =\nmaxX-minX;\n\n//Pattern Height\npatternHeight =\nmaxY-minY;\n\n//Bounds Ratio\npatternHeight/patternWidth;",
      "Id": "91186e04cb3b42cc97d4dac1cda68cb5",
      "Inputs": [
        {
          "Id": "852c3c59a3d346b29114270905e1baf6",
          "Name": "curve",
          "Description": "curve",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "fcdec1e487fa4ac8b208583a7d21d7b1",
          "Name": "",
          "Description": "allPoints",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4a85669725664bafb451b9bf857c8e8d",
          "Name": "",
          "Description": "pointX",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8c080da2b2a545049ad1a14d03513495",
          "Name": "",
          "Description": "pointY",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "91b010e73bca485abc45f8eec1d6ba00",
          "Name": "",
          "Description": "minX",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8abb5ba9dcab4a1ebd1d6f5d4379a38e",
          "Name": "",
          "Description": "minY",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "5b08257333f44b839c932066cf5063f8",
          "Name": "",
          "Description": "maxX",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "cc11ea7c6ce14ba7b5dfa88819940f25",
