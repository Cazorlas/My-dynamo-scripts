    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "//Report Longest Line Family\nlongestLine>1200?\n\"WARNING! A line family exceeds 1200 IN (\"+longestLine+\" IN). This Pattern will Not Load, try a Lower Tolerance or Shrink your Sketch.\":\n\"Longest Line Family: \"+longestLine+\" IN (Segment + Resulting Dash)\";\n\nlongestLine = List.MaximumItem((\nList.Flatten(segmentLength, -1)+\nList.Flatten(dashLength, -1)\n)*12);",
      "Id": "b14a0b9de35649f89a7e0e5dad685575",
      "Inputs": [
        {
          "Id": "90712f50ecc24f39ba9a8bc6486c316c",
