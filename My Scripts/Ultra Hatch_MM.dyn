          "Id": "c42e12206a1b495ea0b638e77f4e1d7d",
          "Name": "",
          "Description": "Value of expression at line 2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "42cf9a0f71544d68946ff31495649978",
          "Name": "",
          "Description": "longestLine",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "//Available Angles from X Axis\n//  Any Diagonal Line will be\n//  Corrected to one of these.\nList.Count(angles)+\n\" Available Angles: \"+\nString.Join(\", \",angles)+\n\" (from X Axis)\";",
      "Id": "8f1bbbfa78f14b1a89efe798cbf2651d",
      "Inputs": [
        {
