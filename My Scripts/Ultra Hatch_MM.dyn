    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "//Available Line Types Generator\n//This Node is Necessary to Prevent the occurrence of Diagonal Lines\n//  with Irregular Slopes. If you plot a Line at just any Angle,\n//  the Slope could be 1/854,239,645 and the Resulting Dash (to get\n//  back to the same place on the grid) would be well over 1200 IN.\n//  Line Families that exceed 1200 IN will not load!\n\nriseSeq = (boundsRatio..#tolerance..boundsRatio);\nrise = List.Flatten(List.OfRepeatedItem(riseSeq@L1<1>,tolerance),-1);\nrunSeq = (1..#tolerance..1);\nrun = List.Flatten(List.OfRepeatedItem(runSeq,tolerance),-1);\ndiagonal = Math.Round(Math.Sqrt(Math.Pow(rise,2)+Math.Pow(run,2)),7);\ndegrees = Math.Round(Math.Atan(rise/run),7);\nltIndex = List.FirstIndexOf(degrees,List.UniqueItems(degrees));\n\nlineTypes =\nList.Flatten([\n[[0,0,1,1]],\nList.Transpose([\nList.GetItemAtIndex(degrees,ltIndex),\nList.GetItemAtIndex(rise,ltIndex),\nList.GetItemAtIndex(run,ltIndex),\nList.GetItemAtIndex(diagonal,ltIndex)\n]),\n[[90,boundsRatio,0,boundsRatio]]\n],1);\n\n//Degrees\ndegreesSorted = List.Sort(degreesCleaned);\ndegreesCleaned = List.GetItemAtIndex(lineTypes@L2<1>, 0);\ndegreeIndex = List.AllIndicesOf(degreesCleaned,degreesSorted);\n\n//Diagonal\nList.GetItemAtIndex(\nList.GetItemAtIndex(lineTypes@L2<1>, 3),\ndegreeIndex);\n\n//X Origin Multiplier\nList.GetItemAtIndex(Math.Max(\nList.GetItemAtIndex(lineTypes@L2<1>, 1),\nList.GetItemAtIndex(lineTypes@L2<1>, 2)\n),degreeIndex);",
      "Id": "09fa26a603d24d7b9c5ce9d87fde9338",
      "Inputs": [
        {
          "Id": "a1d112ab2a1d47f2af727f50550ceda4",
          "Name": "boundsRatio",
          "Description": "boundsRatio",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6fa457ab5e004e62a0724c9f44db312e",
          "Name": "tolerance",
          "Description": "tolerance",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "828d2db93d2f411eb96ff318ecb413a6",
          "Name": "",
          "Description": "riseSeq",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "dad480411c87416891183736298a1454",
          "Name": "",
          "Description": "rise",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a676baf2522b443e957f44fd517d06c4",
          "Name": "",
          "Description": "runSeq",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a2f32e3bbf5d43f0801050e2d302e24d",
          "Name": "",
          "Description": "run",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "91860c3f70c94e07ac0f34a1f569924b",
          "Name": "",
          "Description": "diagonal",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "666d59c1d3894b0e921d659c1fffe2db",
          "Name": "",
          "Description": "degrees",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "dffd1bf350fb424f9b546a48c2d6ca5f",
          "Name": "",
          "Description": "ltIndex",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "cde33e35844f486f86328be19e9e5e78",
          "Name": "",
          "Description": "lineTypes",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "692407b8fcd04e33af2ef0c400c0e9ce",
          "Name": "",
          "Description": "degreesSorted",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e4c1a8b29d904219a4cfa98e5ad2de21",
          "Name": "",
          "Description": "degreesCleaned",
