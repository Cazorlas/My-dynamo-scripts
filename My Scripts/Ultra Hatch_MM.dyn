    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "NodeType": "StringInputNode",
      "InputValue": "This Graph will Write a Hatch Pattern Text File for any set of Straight Lines.\r\n\r\nDrag Select over a group of Lines in a Plan or Drafting View.\r\nFor patterns that have a lot of Blank Space, you have the option to add a Border.\r\n    Just type in the Line Style that you are using if one exists; it need not be Square.\r\nThe Slope Tolerance governs the available Angle that Diagonal Lines will be corrected to. \r\n    Feel free to Increase it, but if a line family exceeds 1200 IN, the pattern will not load!\r\n    Watch the Slope Tolerance Results to see if a Hatch Pattern cannot be Loaded.",
      "Id": "ccaac96965f246548d1caa22c11d018c",
      "Inputs": [],
      "Outputs": [
