    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "//X Origin\n//  A sequence is generated for each angle so that\n//  a pattern with diagonal lines is not just\n//  continuous allong the Y Axis.\nxOrigin =\n(start..#amount..patternSize);\n\nMath.Round(xOrigin*1,7);\n\nstart =\nGeometry.DistanceTo(\nPlane.ByOriginNormal(origin,Vector.XAxis()),\nstartPoints);\n\namount =\nrunLengths == 0?1:runLengths;\n\nrunLengths = List.GetItemAtIndex(mult, index);",
      "Id": "551b5b2330804736875faf6f7a9a8866",
      "Inputs": [
        {
          "Id": "0415294bf95a4473a61b8691b5c22026",
