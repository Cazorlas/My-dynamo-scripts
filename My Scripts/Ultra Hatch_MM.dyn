          "KeepListStructure": false
        },
        {
          "Id": "9b16cad0a9204d39804383e0262ebb76",
          "Name": "",
          "Description": "Value of expression at line 19",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1fc6353598074efba39f3d1f9f4ee5d6",
          "Name": "",
          "Description": "patternWidth",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8f51c6b9bfe944e0914a4bceb5ca962f",
          "Name": "",
